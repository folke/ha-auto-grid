{
  "name": "ha-auto-grid",
  "version": "0.2.1",
  "private": true,
  "description": "Automatically populated Home Assistant card grids with backend filtering and shared card configuration.",
  "author": "Folke Lemaitre",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "check": "tsc && pnpm check:tests",
    "check:tests": "tsc -p tsconfig.tests.json",
    "test": "node --test tests/*.test.ts",
    "test:browser": "pnpm build && node tests/browser.mjs && node tests/browser.mjs editor",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "pnpm run lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "lit": "3.3.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
